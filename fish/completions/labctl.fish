# labctl completions — generated by `labctl completions fish`
set -l labctl_cmds infra build cluster ssh seed reset login tsh tctl tbot integrate verify status completions help
complete -c labctl -f
complete -c labctl -n '__fish_use_subcommand' -a "$labctl_cmds"
complete -c labctl -n '__fish_seen_subcommand_from infra' -a 'up preview down output register-domain'
complete -c labctl -n '__fish_seen_subcommand_from build' -a '--force --rebuild --local'
complete -c labctl -n '__fish_seen_subcommand_from cluster' -a 'up down'
complete -c labctl -n '__fish_seen_subcommand_from seed' -a 'up remove --remove'
complete -c labctl -n '__fish_seen_subcommand_from integrate' -a 'aws okta entraid awsic'
complete -c labctl -n '__fish_seen_subcommand_from completions' -a 'fish bash zsh'
complete -c labctl -n '__fish_seen_subcommand_from help' -a "$labctl_cmds"
